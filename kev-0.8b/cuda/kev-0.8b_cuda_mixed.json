{
  "input_model": {
    "type": "HfModel",
    "model_path": "Qwen/Qwen3.5-0.8B-Base",
    "load_kwargs": {
      "revision": "dc7cdfe2ee4154fa7e30f5b51ca41bfa40174e68",
      "torch_dtype": "float16"
    }
  },
  "systems": {
    "local_system": {
      "type": "LocalSystem",
      "accelerators": [
        {
          "device": "gpu",
          "execution_providers": ["CUDAExecutionProvider"]
        }
      ]
    }
  },
  "passes": {
    "m": {
      "type": "MobiusBuilder",
      "precision": "fp16",
      "exporter_func": "export_kev_package",
      "exporter_config": {
        "artifact_path": "artifacts/kev",
        "recipe_precision": "mixed",
        "staging_path": "cache/mobius-export",
        "component_session_options": {
          "intra_op_num_threads": 1,
          "inter_op_num_threads": 1,
          "session.intra_op.allow_spinning": "0",
          "session.inter_op.allow_spinning": "0"
        }
      },
      "user_script": "../user_script.py",
      "script_dir": "../.."
    }
  },
  "target": "local_system",
  "output_dir": "build-mixed",
  "cache_dir": "cache",
  "no_artifacts": true
}
