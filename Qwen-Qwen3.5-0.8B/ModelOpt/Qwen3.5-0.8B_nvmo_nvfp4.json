{
    "input_model": {
        "type": "HfModel",
        "model_path": "Qwen/Qwen3.5-0.8B",
        "task": "text-generation",
        "load_kwargs": {
            "torch_dtype": "bfloat16",
            "device_map": "cuda",
            "attn_implementation": "eager"
        }
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "gpu",
                    "execution_providers": ["CUDAExecutionProvider"]
                }
            ]
        }
    },
    "data_configs": [
        {
            "name": "calibration_data",
            "type": "HuggingfaceContainer",
            "load_dataset_config": {
                "params": {
                    "data_name": "Salesforce/wikitext",
                    "subset": "wikitext-2-raw-v1",
                    "split": "train"
                }
            },
            "pre_process_data_config": {
                "params": {
                    "model_name": "Qwen/Qwen3.5-0.8B",
                    "task": "text-generation",
                    "text_cols": ["text"],
                    "strategy": "join",
                    "max_samples": 32,
                    "max_seq_len": 512,
                    "add_special_tokens": false
                }
            },
            "dataloader_config": {
                "params": {
                    "batch_size": 1
                }
            }
        }
    ],
    "passes": {
        "quantization": {
            "type": "NVModelOptQuantization",
            "precision": "nvfp4",
            "data_config": "calibration_data"
        }
    },
    "host": "local_system",
    "target": "local_system",
    "output_dir": "models/nvfp4",
    "log_severity_level": 1
}
