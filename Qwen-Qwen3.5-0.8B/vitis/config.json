{
    "input_model": {
        "type": "CompositeModel",
        "config": {
            "model_path": "exported_model",
            "model_attributes": {
                "architectures": ["Qwen3_5ForConditionalGeneration"],
                "model_type": "qwen3_5"
            }
        }
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "cpu",
                    "execution_providers": ["CPUExecutionProvider"]
                }
            ]
        }
    },
    "data_configs": [
        {
            "name": "wikitext2_train",
            "type": "HuggingfaceContainer",
            "user_script": "user_script.py",
            "load_dataset_config": {
                "data_name": "Salesforce/wikitext",
                "subset": "wikitext-2-raw-v1",
                "split": "train"
            },
            "pre_process_data_config": {
                "type": "text_generation_huggingface_pre_process",
                "model_name": "Qwen/Qwen3.5-0.8B",
                "strategy": "line-by-line",
                "add_special_tokens": false,
                "max_samples": 128,
                "max_seq_len": 512
            },
            "dataloader_config": {
                "type": "qwen35_decoder_dataloader",
                "model_name": "Qwen/Qwen3.5-0.8B",
                "exported_model_path": "exported_model"
            }
        }
    ],
    "passes": {
        "gemm_to_matmul": {
            "type": "GraphSurgeries",
            "surgeries": [{"surgeon": "GemmToMatMulAdd"}],
            "save_as_external_data": true
        },
        "vision_rtn": {
            "type": "OnnxBlockWiseRtnQuantization",
            "bits": 4,
            "block_size": 128,
            "is_symmetric": true,
            "accuracy_level": 4,
            "save_as_external_data": false
        },
        "mq": {
            "type": "MatMulNBitsToQDQ",
            "use_int4": true,
            "add_zero_point": true,
            "save_as_external_data": true
        },
        "gs": {
            "type": "GraphSurgeries",
            "surgeries": [{"surgeon": "SimplifiedLayerNormToL2Norm"}],
            "save_as_external_data": true
        },
        "sq": {
            "type": "OnnxStaticQuantization",
            "data_config": "wikitext2_train",
            "activation_type": "uint16",
            "precision": "uint8",
            "calibration_providers": ["CPUExecutionProvider"],
            "quant_preprocess": false,
            "op_types_to_exclude": [
                "GatherBlockQuantized",
                "GroupQueryAttention",
                "MatMulNBits",
                "SimplifiedLayerNormalization",
                "SkipSimplifiedLayerNormalization"
            ],
            "save_as_external_data": true
        },
        "text_metadata": {
            "type": "VitisAIAddMetaData",
            "config_meta_data_keys": ["architectures", "model_type"],
            "activation_type": "uint16",
            "weight_type": "uint8",
            "quant_type": "OnnxStaticQuantization"
        },
        "vision_metadata": {
            "type": "VitisAIAddMetaData",
            "config_meta_data_keys": ["architectures", "model_type"],
            "weight_type": "int4",
            "quant_type": "RTN"
        }
    },
    "engine": {
        "host": "local_system",
        "target": "local_system",
        "evaluate_input_model": false,
        "log_severity_level": 1,
        "cache_dir": "cache"
    },
    "builds": {
        "_default": {
            "output_dir": "optimized_model"
        },
        "decoder": {
            "components": ["decoder"],
            "pipeline": ["gs", "sq", "text_metadata"]
        },
        "vision_encoder": {
            "components": ["vision_encoder"],
            "pipeline": ["gemm_to_matmul", "vision_rtn", "mq", "vision_metadata"]
        }
    },
    "max_concurrent_builds": 1
}
