{
    "input_model": {
        "type": "HfModel",
        "model_path": "LiquidAI/LFM2.5-1.2B-Thinking",
        "load_kwargs": {
            "torch_dtype": "float16"
        }
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "gpu",
                    "execution_providers": [
                        "WebGpuExecutionProvider"
                    ]
                }
            ]
        }
    },
    "passes": {
        "m": {
            "type": "ModelBuilder",
            "precision": "int4",
            "extra_options": {
                "algo_config": "k_quant",
                "matmul_mixed_precision": "last_matmul:int8,mixed_layers:int8",
                "block_size": 32
            }
        }
    },
    "target": "local_system",
    "log_severity_level": 0,
    "output_dir": "model",
    "cache_dir": "cache",
    "no_artifacts": true
}
