{
    "input_model": {
        "type": "HfModel",
        "model_path": "meta-models/Muse-Glimmer-30B"
    },
    "passes": {
        "mobius_build": {
            "type": "MobiusBuilder",
            "precision": "bf16"
        },
        "int4_quantize": {
            "type": "OnnxKQuantQuantization",
            "bits": 4,
            "block_size": 32,
            "save_as_external_data": true
        }
    },
    "target": {
        "type": "LocalSystem",
        "accelerators": [
            {
                "device": "gpu",
                "execution_providers": [
                    "CUDAExecutionProvider"
                ]
            }
        ]
    },
    "output_dir": "cuda/int4/models"
}
