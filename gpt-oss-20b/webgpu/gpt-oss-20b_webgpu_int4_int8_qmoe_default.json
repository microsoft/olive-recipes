{
    "input_model": {
        "type": "HfModel",
        "model_path": "openai/gpt-oss-20b",
        "load_kwargs": {
            "torch_dtype": "float16"
        }
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "gpu",
                    "execution_providers": ["WebGpuExecutionProvider"]
                }
            ]
        }
    },
    "passes": {
        "m": {
            "type": "ModelBuilder",
            "precision": "int4",
            "extra_options": {
                "algo_config": "default",
                "block_size": 32,
                "op_types_to_quantize": [
                    "MatMul",
                    "Gather"
                ],
                "nodes_to_exclude": [
                    "/model/layers.0/moe/router/MatMul",
                    "/model/layers.1/moe/router/MatMul",
                    "/model/layers.2/moe/router/MatMul",
                    "/model/layers.3/moe/router/MatMul",
                    "/model/layers.4/moe/router/MatMul",
                    "/model/layers.5/moe/router/MatMul",
                    "/model/layers.6/moe/router/MatMul",
                    "/model/layers.7/moe/router/MatMul",
                    "/model/layers.8/moe/router/MatMul",
                    "/model/layers.9/moe/router/MatMul",
                    "/model/layers.10/moe/router/MatMul",
                    "/model/layers.11/moe/router/MatMul",
                    "/model/layers.12/moe/router/MatMul",
                    "/model/layers.13/moe/router/MatMul",
                    "/model/layers.14/moe/router/MatMul",
                    "/model/layers.15/moe/router/MatMul",
                    "/model/layers.16/moe/router/MatMul",
                    "/model/layers.17/moe/router/MatMul",
                    "/model/layers.18/moe/router/MatMul",
                    "/model/layers.19/moe/router/MatMul",
                    "/model/layers.20/moe/router/MatMul",
                    "/model/layers.21/moe/router/MatMul",
                    "/model/layers.22/moe/router/MatMul",
                    "/model/layers.23/moe/router/MatMul"
                ],
                "moe_quant_type": "int8",
                "qmoe_block_size": 32,
                "matmulnbits_weights_prepacked": 0,
                "qmoe_weights_prepacked": -1,
                "fuse_qk_norm_gqa": true
            }
        }
    },
    "target": "local_system",
    "log_severity_level": 0,
    "output_dir": "model_int4_int8_qmoe_default",
    "cache_dir": "cache",
    "no_artifacts": true
}
