{
    "input_model": {
        "type": "HfModel",
        "model_path": "Qwen/Qwen3.5-2B"
    },
    "passes": {
        "m": {
            "type": "ModelBuilder",
            "precision": "int4",
            "accuracy_level": 4,
            "algo_config": "k_quant",
            "matmul_mixed_precision": "last_matmul:int8,mixed_layers:int8",
            "block_size": 128,
            "extra_options": {
                "filename": "text.onnx",
                "prune_lm_head": true
            }
        },
        "t": {
            "type": "GraphSurgeries",
            "surgeries": [{"surgeon": "TieWordEmbeddings"}]
        }
    },
    "no_artifacts": true,
    "output_dir": "cpu_and_mobile/models/text.onnx"
}
