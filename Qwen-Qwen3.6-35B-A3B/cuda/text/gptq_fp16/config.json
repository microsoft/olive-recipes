{
    "input_model": {
        "type": "HfModel",
        "model_path": "Qwen/Qwen3.6-35B-A3B",
        "task": "text-generation",
        "load_kwargs": {
            "revision": "995ad96eacd98c81ed38be0c5b274b04031597b0",
            "trust_remote_code": false
        }
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "gpu",
                    "execution_providers": ["CUDAExecutionProvider"]
                }
            ]
        }
    },
    "target": "local_system",
    "data_configs": [
        {
            "name": "wikitext2_train",
            "type": "HuggingfaceContainer",
            "load_dataset_config": {
                "data_name": "Salesforce/wikitext",
                "subset": "wikitext-2-raw-v1",
                "split": "train",
                "revision": "b08601e04326c79dfdd32d625aee71d232d685c3"
            },
            "pre_process_data_config": {
                "strategy": "join",
                "add_special_tokens": false,
                "max_samples": 512,
                "max_seq_len": 2048
            },
            "dataloader_config": {
                "batch_size": 1
            }
        }
    ],
    "passes": {
        "gptq": {
            "type": "Gptq",
            "bits": 4,
            "group_size": 128,
            "sym": true,
            "moe": true,
            "lm_head": false,
            "data_config": "wikitext2_train"
        },
        "mobius": {
            "type": "MobiusBuilder",
            "precision": "fp16",
            "text_only": true
        }
    },
    "output_dir": "cuda/text/gptq_fp16/models"
}
