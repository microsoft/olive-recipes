{
    "input_model": {
        "type": "HfModel",
        "model_path": "Qwen/Qwen3.6-35B-A3B",
        "load_kwargs": {
            "trust_remote_code": true
        }
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "gpu",
                    "execution_providers": ["CUDAExecutionProvider"]
                }
            ]
        }
    },
    "target": "local_system",
    "passes": {
        "rtn": {
            "type": "Rtn",
            "bits": 4,
            "group_size": 128,
            "sym": true,
            "moe": true
        },
        "mobius": {
            "type": "MobiusBuilder",
            "precision": "fp16"
        }
    },
    "output_dir": "cuda/rtn_fp16/models"
}
