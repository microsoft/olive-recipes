{
    "input_model": {
        "type": "HfModel",
        "model_path": "LiquidAI/LFM2.5-Audio-1.5B",
        "load_kwargs": { "torch_dtype": "float16" }
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [{ "device": "gpu", "execution_providers": ["WebGpuExecutionProvider"] }]
        }
    },
    "passes": {
        "m": {
            "type": "ModelBuilder",
            "precision": "int4",
            "exclude_embeds": true,
            "include_hidden_states": true,
            "extra_options": {
                "block_size": 32,
                "matmul_mixed_precision": "last_matmul:int8",
                "accuracy_level": 0
            }
        }
    },
    "target": "local_system",
    "log_severity_level": 0,
    "output_dir": "model",
    "cache_dir": "cache",
    "no_artifacts": true
}
