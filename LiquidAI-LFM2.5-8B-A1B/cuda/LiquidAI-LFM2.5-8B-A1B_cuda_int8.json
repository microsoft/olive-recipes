{
    "input_model": {
        "type": "HfModel",
        "model_path": "LiquidAI/LFM2.5-8B-A1B",
        "load_kwargs": { "torch_dtype": "float16" }
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [{ "device": "gpu", "execution_providers": ["CUDAExecutionProvider"] }]
        }
    },
    "passes": {
        "m": {
            "type": "ModelBuilder",
            "precision": "int8",
            "extra_options": {
                "qmoe_block_size": 32
            }
        }
    },
    "target": "local_system",
    "log_severity_level": 0,
    "output_dir": "model",
    "cache_dir": "cache",
    "no_artifacts": true
}
