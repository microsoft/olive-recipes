{
    "input_model": {
        "type": "HfModel",
        "model_path": "Qwen/Qwen3.8-27B",
        "load_kwargs": {
            "torch_dtype": "float16"
        }
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "gpu",
                    "execution_providers": [
                        "CUDAExecutionProvider"
                    ]
                }
            ]
        }
    },
    "passes": {
        "builder_int4_int8_embed_int4_per_channel_kv_paged_dflash2_int4_32gb": {
            "type": "ModelBuilder",
            "precision": "int4",
            "extra_options": {
                "block_size": 32,
                "op_types_to_quantize": "MatMul/Gather",
                "quant_config": "[{\"match\": {\"name\": \"/model/embed_tokens/Gather\"}, \"type\": \"int8\"}]",
                "matmulnbits_weights_prepacked": 1,
                "use_device_allocator_for_initializers": true,
                "enable_cuda_graph": true,
                "use_paged_attention": true,
                "paged_block_size": 256,
                "max_batch_size": 1,
                "max_scheduled_tokens": 2048,
                "paged_chunk_size": 2048,
                "num_blocks": 1152,
                "kv_cache_quant_scheme": "int4_per_channel",
                "kv_cache_scale_file": "kv_scales_int8_per_channel.json",
                "dflash2_path": "Qwen3.8-27B-DFlash2",
                "dflash2_num_draft_tokens": 7,
                "max_draft_tokens": 7,
                "dflash2_precision": "int4",
                "aux_hidden_state_layers": "6,20,34,48,62",
                "state_update_capacity": 7
            }
        }
    },
    "target": "local_system",
    "log_severity_level": 0,
    "output_dir": "model_int4_int8_embed_int4_per_channel_kv_paged_dflash2_int4_32gb",
    "cache_dir": "cache",
    "no_artifacts": false
