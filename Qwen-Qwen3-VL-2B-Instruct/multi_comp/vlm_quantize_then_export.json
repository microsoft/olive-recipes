{
    "input_model": {
        "type": "HfModel",
        "model_path": "Qwen/Qwen3-VL-2B-Instruct",
        "task": "image-text-to-text",
        "load_kwargs": { "trust_remote_code": true }
    },
    "systems": {
        "local_gpu": {
            "type": "LocalSystem",
            "accelerators": [ { "device": "gpu", "execution_providers": [ "CUDAExecutionProvider" ] } ]
        }
    },
    "passes": {
        "decoder_kquant": {
            "type": "KQuant",
            "bits": 4,
            "group_size": 128,
            "sym": true,
            "lm_head": false
        }
    },
    "host": "local_gpu",
    "target": "local_gpu",
    "evaluate_input_model": false,
    "cache_dir": "cache",
    "output_dir": "vlm_decoder_kquant_hf",
    "builds": {
        "decoder_kquant": {
            "components": [ "decoder" ],
            "pipeline": [ "decoder_kquant" ]
        }
    }
}
