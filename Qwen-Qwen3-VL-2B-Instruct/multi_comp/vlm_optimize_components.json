{
    "input_model": { "type": "CompositeModel", "config": { "model_path": "exported_vlm_pkg" } },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [ { "device": "cpu", "execution_providers": [ "CPUExecutionProvider" ] } ]
        }
    },
    "passes": {
        "to_fp16": { "type": "OnnxFloatToFloat16", "keep_io_types": true },
        "dynamic_quant": { "type": "OnnxDynamicQuantization" }
    },
    "engine": { "host": "local_system", "target": "local_system", "evaluate_input_model": false, "cache_dir": "cache" },
    "builds": {
        "_default": { "output_dir": "optimized_vlm_pkg" },
        "decoder": { "components": [ "decoder" ], "pipeline": [ "dynamic_quant" ] },
        "vision_encoder": {
            "components": [ "vision_encoder" ],
            "pipeline": [ "to_fp16" ]
        },
        "embedding": { "components": [ "embedding" ], "pipeline": [ "to_fp16" ] }
    }
}
