{
    "input_model": {
        "type": "HFModel",
        "model_path": "mistralai/Mistral-7B-Instruct-v0.3"
    },
    "passes": {
        "qp": {
            "type": "QairtPreparation",
	    "script_path": "mistral_adascale_run.py",
            "script_config": {
                "PLATFORM_GEN": 2,
                "SKIP_ADASCALE": true,
                "ADASCALE_DIR": "adascale_2"
            }
        },
        "qgab": {
            "type": "QairtGenAIBuilder",
            "log_level": "INFO",
            "backend": "HTP",
            "soc_details": "chipset:SC8480XP",
            "vtcm_size_in_mb": 8,
            "hvx_threads": 8,
	    "extended_udma": true,
	    "sequence_lengths": [32, 128],
            "native_kv": true,
            "context_lengths": [ 512, 1024, 2048, 3072, 4096, 8192, 16384 ]
        },
        "qe": {
            "type": "QairtEncapsulation",
            "log_level": "ERROR",
            "run_checker": "true",
            "engine_config_overrides": {
                "n_threads": 3,
                "htp": { "cpu_mask": "0xe0", "allow_async_init": false, "poll": false, "mmap_budget": 0 }
            },
            "backend_extensions_overrides": {
                "graphs": null,
                "devices": [ { "pd_session": "unsigned" } ],
                "groupContext": { "share_resources": false },
                "memory": { "mem_type": "shared_buffer" },
                "context": [ { "weight_sharing_enabled": true, "reused_io_limit_mb": 100 } ]
            }
        }
    },
    "log_severity_level": 1,
    "output_dir": "models/mistral-7b-instruct-qairt-sc8480xp",
    "cache_dir": "cache",
    "no_artifacts": true
}
