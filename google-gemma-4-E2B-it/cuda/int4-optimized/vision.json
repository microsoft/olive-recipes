{
    "input_model": {
        "type": "ONNXModel",
        "model_path": "cuda/int4-optimized/models/vision_encoder",
        "onnx_file_name": "model.onnx"
    },
    "passes": {
        "int8": {
            "type": "OnnxBlockWiseRtnQuantization",
            "bits": 8,
            "block_size": 32,
            "is_symmetric": false,
            "save_as_external_data": true,
            "external_data_name": "model.onnx.data"
        }
    },
    "target": {
        "type": "LocalSystem",
        "accelerators": [
            {"device": "gpu", "execution_providers": ["CUDAExecutionProvider"]}
        ]
    },
    "output_dir": "cuda/int4-optimized/models/vision_encoder"
}
