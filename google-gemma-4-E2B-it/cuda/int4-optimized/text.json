{
    "input_model": {
        "type": "ONNXModel",
        "model_path": "cuda/int4-optimized/models/decoder",
        "onnx_file_name": "model.onnx"
    },
    "passes": {
        "int4_quantize": {
            "type": "OnnxBlockWiseRtnQuantization",
            "bits": 4,
            "block_size": 32,
            "is_symmetric": true,
            "save_as_external_data": true,
            "external_data_name": "model.onnx.data"
        },
        "shared_kv": {
            "type": "GraphSurgeries",
            "surgeries": [
                {"surgeon": "RemoveUnusedGQACacheOutputs", "cache_type": "float16"}
            ],
            "remove_duplicate_initializers": false,
            "save_as_external_data": true,
            "external_data_name": "model.onnx.data"
        }
    },
    "target": {
        "type": "LocalSystem",
        "accelerators": [
            {"device": "gpu", "execution_providers": ["CUDAExecutionProvider"]}
        ]
    },
    "output_dir": "cuda/int4-optimized/models/decoder"
}
