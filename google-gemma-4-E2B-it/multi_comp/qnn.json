{
    "input_model": {
        "type": "CompositeModel",
        "config": {
            "model_path": "gemma4_onnx"
        }
    },
    "systems": {
        "qnn_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "npu",
                    "execution_providers": [
                        "QNNExecutionProvider"
                    ]
                }
            ]
        }
    },
    "data_configs": [
        {
            "name": "calib",
            "user_script": "user_script.py",
            "load_dataset_config": {
                "type": "wikitext_decoder_calibration_dataset",
                "embedding_model_path": "gemma4_onnx/embedding/model.onnx",
                "num_samples": 32,
                "seq_len": 64,
                "past_len": 64
            },
            "dataloader_config": {
                "type": "no_auto_batch_dataloader"
            }
        },
        {
            "name": "cauldron_vision_calibration",
            "user_script": "user_script.py",
            "load_dataset_config": {
                "type": "cauldron_calibration_dataset",
                "subsets": [
                    "vqav2",
                    "visual7w",
                    "ai2d",
                    "chartqa",
                    "docvqa",
                    "textvqa",
                    "screen2words",
                    "scienceqa"
                ],
                "samples_per_subset": 16,
                "seed": 42,
                "shuffle_buffer_size": 0,
                "max_soft_tokens": 280
            },
            "dataloader_config": {
                "type": "no_auto_batch_dataloader"
            }
        }
    ],
    "passes": {
        "gs_vision": {
            "type": "GraphSurgeries",
            "surgeries": [
                {
                    "surgeon": "RemoveUnusedNodeOutputs",
                    "op_types": [
                        "SkipSimplifiedLayerNormalization"
                    ]
                },
                {
                    "surgeon": "SimplifiedLayerNormToL2Norm"
                },
                {
                    "surgeon": "RMSNormalizationToL2Norm"
                },
                {
                    "surgeon": "ReplaceAttentionMaskValue",
                    "threshold": -1e8
                }
            ],
            "save_as_external_data": true
        },
        "a16w8_static_quantization": {
            "type": "OnnxStaticQuantization",
            "data_config": "cauldron_vision_calibration",
            "activation_type": "uint16",
            "precision": "int8",
            "quant_format": "QDQ",
            "calibrate_method": "MinMax",
            "calibration_providers": [
                "CUDAExecutionProvider"
            ],
            "quant_preprocess": false,
            "prepare_qdq_config": true,
            "extra_options": {
                "DedicatedQDQPair": true
            },
            "save_as_external_data": true
        },
        "matmul_nbits_to_qdq": {
            "type": "MatMulNBitsToQDQ",
            "use_signed_int": true,
            "add_zero_point": true,
            "save_as_external_data": true
        },
        "dynamic_to_fixed_shape": {
            "type": "DynamicToFixedShape",
            "dim_param": [
                "component.vision_encoder.num_patches"
            ],
            "dim_value": [
                2520
            ],
        "f16_vision": {
            "type": "OnnxFloatToFloat16",
            "keep_io_types": true,
            "save_as_external_data": true
        },
            "save_as_external_data": true
        },
        "embedding_cast": {
            "type": "GraphSurgeries",
            "surgeries": [
                {
                    "surgeon": "CastOutputs",
                    "names": [
                        "inputs_embeds",
                        "per_layer_inputs"
                    ],
                    "to": "float16"
                }
            ],
            "save_as_external_data": true
        },
        "vision_cb": {
            "type": "EPContextBinaryGenerator",
            "provider_options": {
                "htp_performance_mode": "burst",
                "htp_graph_finalization_optimization_mode": "3",
                "soc_model": "60",
                "vtcm_mb": "7"
            },
            "session_options": {
                "optimization.disable_specified_optimizers": "QDQPropagationTransformer",
                "log_severity_level": 1
            }
        },
        "gs_decoder": {
            "type": "GraphSurgeries",
            "surgeries": [
                {
                    "surgeon": "ConstantAttributesToTensor"
                },
                {
                    "surgeon": "FuseDecomposedRMSNorm"
                },
                {
                    "surgeon": "RemoveRopeMultiCache"
                },
                {
                    "surgeon": "AttentionMaskToSequenceLengths"
                },
                {
                    "surgeon": "RemoveGidxFromMatMulNBits"
                },
                {
                    "surgeon": "RemoveUnusedNodeOutputs",
                    "op_types": [
                        "SkipSimplifiedLayerNormalization"
                    ]
                },
                {
                    "surgeon": "SimplifiedLayerNormToL2Norm",
                    "op_types": [
                        "SkipSimplifiedLayerNormalization"
                    ]
                },
                {
                    "surgeon": "RemoveInitializerValueInfo"
                }
            ],
            "save_as_external_data": true
        },
        "f16": {
            "type": "OnnxFloatToFloat16",
            "op_include_list": [
                "GroupQueryAttention"
            ],
            "keep_io_types": [
                "logits"
            ],
            "save_as_external_data": true
        },
        "gs_decoder_post_f16": {
            "type": "GraphSurgeries",
            "surgeries": [
                {
                    "surgeon": "DeduplicateNodes"
                },
                {
                    "surgeon": "RemoveShapes"
                },
                {
                    "surgeon": "RemoveInitializerValueInfo"
                },
                {
                    "surgeon": "RemoveUnusedNodeOutputs",
                    "op_types": [
                        "SkipSimplifiedLayerNormalization"
                    ]
                },
                {
                    "surgeon": "ConstantAttributesToTensor"
                }
            ],
            "save_as_external_data": true
        },
        "matmul_nbits_to_qdq_decoder": {
            "type": "MatMulNBitsToQDQ",
            "use_signed_int": true,
            "add_zero_point": true,
            "use_int8_per_channel": true,
            "save_as_external_data": true
        },
        "sq_decoder": {
            "type": "OnnxStaticQuantization",
            "data_config": "calib",
            "activation_type": "uint16",
            "precision": "uint8",
            "calibration_providers": [
                "CUDAExecutionProvider"
            ],
            "quant_preprocess": true,
            "op_types_to_exclude": [
                "GatherBlockQuantized",
                "GroupQueryAttention",
                "MatMulNBits",
                "ConstantOfShape"
            ],
            "save_as_external_data": true
        },
        "sp": {
            "type": "SplitModel",
            "split_assignments": {
                "decoder.model.layers.0": 0,
                "decoder.model.layers.5": 1,
                "decoder.model.layers.10": 2,
                "decoder.model.layers.15": 3,
                "decoder.model.layers.20": 4,
                "decoder.model.layers.25": 5,
                "decoder.model.layers.30": 6,
                "decoder.lm_head": 7
            }
        },
        "kv": {
            "type": "DynamicToFixedShape",
            "dim_param": [
                "component.decoder.past_sequence_len",
                "component.decoder.kv_sequence_length"
            ],
            "dim_value": [
                1024,
                1024
            ]
        },
        "st": {
            "type": "StaticLLM",
            "batch_size": 1,
            "context_length": 64
        },
        "cb": {
            "type": "EPContextBinaryGenerator",
            "provider_options": {
                "htp_performance_mode": "burst",
                "htp_graph_finalization_optimization_mode": "3",
                "soc_model": "60",
                "vtcm_mb": "7"
            },
            "weight_sharing": true,
            "session_options": {
                "optimization.disable_specified_optimizers": "QDQPropagationTransformer",
                "log_severity_level": 1
            }
        },
        "cp": {
            "type": "ComposeOnnxModels"
        }
    },
    "builds": {
        "decoder": {
            "components": [
                "decoder"
            ],
            "pipeline": [
                "matmul_nbits_to_qdq_decoder",
                "gs_decoder",
                "f16",
                "gs_decoder_post_f16",
                "sq_decoder",
                "sp",
                "kv",
                "st",
                "cb",
                "cp"
            ]
        },
        "embedding": {
            "components": [
                "embedding"
            ],
            "pipeline": [
                "embedding_cast"
            ]
        },
        "vision": {
            "components": [
                "vision_encoder"
            ],
            "pipeline": [
                "matmul_nbits_to_qdq",
                "gs_vision",
                "f16_vision",
                "a16w8_static_quantization",
                "dynamic_to_fixed_shape",
                "vision_cb"
            ]
        }
    },
    "target": "qnn_system",
    "output_dir": "gemma4_qnn",
    "log_severity_level": 1
}
