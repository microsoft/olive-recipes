{
    "input_model": {
        "type": "CompositeModel",
        "config": {
            "model_path": "gemma4_onnx"
        }
    },
    "data_configs": [
        {
            "name": "cauldron_vision_calibration",
            "user_script": "user_script.py",
            "load_dataset_config": {
                "type": "cauldron_calibration_dataset",
                "subsets": [
                    "vqav2",
                    "visual7w",
                    "ai2d",
                    "chartqa",
                    "docvqa",
                    "textvqa",
                    "screen2words",
                    "scienceqa"
                ],
                "samples_per_subset": 16,
                "seed": 42,
                "shuffle_buffer_size": 0,
                "max_soft_tokens": 280
            },
            "dataloader_config": {
                "type": "no_auto_batch_dataloader"
            }
        }
    ],
    "passes": {
        "graph_surgeries": {
            "type": "GraphSurgeries",
            "surgeries": [{"surgeon": "RemoveUnusedOutputs"},
                          {"surgeon": "SimplifiedLayerNormToL2Norm"},
                          {"surgeon": "RMSNormalizationToL2Norm"},
                          {"surgeon": "ReplaceAttentionMaskValue",  "threshold": -1e8}],
            "save_as_external_data": true,
            "external_data_name": "model.onnx.data"
        },
        "decoder_kquant": {
            "type": "OnnxKQuantQuantization",
            "bits": 4,
            "block_size": 128,
            "customized_weight_config": {
                "decoder/lm_head/MatMul_node_1540": {
                    "bits": 8
                }
            }
        },
        "a16w8_static_quantization": {
            "type": "OnnxStaticQuantization",
            "data_config": "cauldron_vision_calibration",
            "activation_type": "uint16",
            "precision": "int8",
            "quant_format": "QDQ",
            "calibrate_method": "MinMax",
            "quant_preprocess": false,
            "prepare_qdq_config": true,
            "extra_options": {
                "DedicatedQDQPair": true
            },
            "save_as_external_data": true,
            "external_data_name": "model.onnx.data"
        },
        "embedding_kquant": {
            "type": "OnnxKQuantQuantization",
            "bits": 8,
            "block_size": 128
        },
        "matmul_nbits_to_qdq": {
            "type": "MatMulNBitsToQDQ",
            "use_signed_int": true,
            "add_zero_point": true,
            "save_as_external_data": true,
            "external_data_name": "model.onnx.data"
        }
    },
    "builds": {
        "decoder": {
            "components": [ "decoder" ],
            "pipeline": [ "decoder_kquant", "matmul_nbits_to_qdq" ]
        },
        "vision": {
            "components": [ "vision_encoder" ],
            "pipeline": [ "graph_surgeries", "a16w8_static_quantization" ]
        },
        "embedding": {
            "components": ["embedding"],
            "pipeline": ["embedding_kquant", "matmul_nbits_to_qdq"]
        }
    },
    "output_dir": "gemma4_quantized_onnx",
    "log_severity_level": 0
}
