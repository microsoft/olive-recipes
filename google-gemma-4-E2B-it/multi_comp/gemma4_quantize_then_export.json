{
    "input_model": {
        "type": "HfModel",
        "config": {
            "model_path": "google/gemma-4-E2B-it",
            "task": "image-text-to-text",
            "load_kwargs": { "torch_dtype": "float16", "trust_remote_code": true }
        }
    },
    "passes": {
        "decoder_kquant": {
            "type": "KQuant",
            "bits": 4,
            "group_size": 128,
            "sym": false,
            "lm_head": true,
            "embeds": true,
            "quantize_vision": false,
            "overrides": {
                "lm_head": {"bits": 8},
                "model.language_model.embed_tokens": {"bits": 8}
            }
        },
        "vision_rtn": {
            "type": "Rtn",
            "bits": 4,
            "group_size": 128,
            "sym": true,
            "lm_head": false,
            "embeds": false,
            "quantize_vision": true
        }
    },
    "builds": {
        "_default": {
            "output_dir": "gemma4_mixed_hf"
        },
        "decoder": {
            "components": [ "decoder" ],
            "pipeline": [ "decoder_kquant" ]
        },
        "vision": {
            "components": [ "vision_encoder" ],
            "pipeline": [ "vision_rtn" ]
        }
    }
}
