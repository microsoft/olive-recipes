{
    "input_model": {
        "type": "CompositeModel",
        "config": {
            "model_path": "gemma4_onnx"
        }
    },
    "data_configs": [
        {
            "name": "calib",
            "user_script": "user_script.py",
            "load_dataset_config": {
                "type": "wikitext_decoder_calibration_dataset",
                "embedding_model_path": "gemma4_onnx/embedding/model.onnx",
                "num_samples": 32,
                "seq_len": 64,
                "past_len": 64,
                "output_dtype": "float32"
            },
            "dataloader_config": {
                "type": "no_auto_batch_dataloader"
            }
        },
        {
            "name": "cauldron_vision_calibration",
            "user_script": "user_script.py",
            "load_dataset_config": {
                "type": "cauldron_calibration_dataset",
                "subsets": [
                    "vqav2",
                    "visual7w",
                    "ai2d",
                    "chartqa",
                    "docvqa",
                    "textvqa",
                    "screen2words",
                    "scienceqa"
                ],
                "samples_per_subset": 16,
                "seed": 42,
                "shuffle_buffer_size": 0,
                "max_soft_tokens": 280
            },
            "dataloader_config": {
                "type": "no_auto_batch_dataloader"
            }
        }
    ],
    "passes": {
        "gs_decoder": {
            "type": "GraphSurgeries",
            "surgeries": [
                {
                    "surgeon": "ConstantAttributesToTensor"
                },
                {
                    "surgeon": "FuseDecomposedRMSNorm"
                },
                {
                    "surgeon": "RemoveGidxFromMatMulNBits"
                },
                {
                    "surgeon": "AttentionMaskToSequenceLengths"
                },
                {
                    "surgeon": "RemoveUnusedNodeOutputs",
                    "op_types": [
                        "SkipSimplifiedLayerNormalization"
                    ]
                },
                {
                    "surgeon": "SimplifiedLayerNormToL2Norm"
                }
            ],
            "save_as_external_data": true
        },
        "ov_conversion": {
            "type": "OpenVINOConversion",
            "static": false,
            "compress_to_fp16": false,
            "model_name": "model"
        },
        "ov_encapsulation": {
            "type": "OpenVINOEncapsulation",
            "target_device": "npu",
            "keep_ov_dynamic_dims": true,
            "update_genai_config": true,
            "genai_config_override": {
                "model": {
                    "decoder": {
                        "session_options": {
                            "graph_optimization_level": "ORT_DISABLE_ALL",
                            "ep.context_file_path": "decoder/model.onnx",
                            "provider_options": [
                                {
                                    "OpenVINO": {
                                        "device_type": "NPU",
                                        "enable_causallm": "True",
                                        "load_config": "{\"NPU\":{\"MAX_PROMPT_LEN\":\"1024\",\"MIN_RESPONSE_LEN\":\"128\",\"NPUW_DEVICES\":\"NPU\",\"NPUW_FALLBACK_EXEC\":\"NO\"}}"
                                    }
                                }
                            ]
                        }
                    },
                    "embedding": {
                        "session_options": {
                            "provider_options": []
                        }
                    },
                    "speech": {
                        "session_options": {
                            "provider_options": []
                        }
                    }
                },
                "search": {
                    "past_present_share_buffer": false
                }
            }
        },
        "gs_vision": {
            "type": "GraphSurgeries",
            "surgeries": [{"surgeon": "RemoveUnusedNodeOutputs"},
                          {"surgeon": "SimplifiedLayerNormToL2Norm"},
                          {"surgeon": "ReplaceAttentionMaskValue",  "threshold": -1e8}],
            "save_as_external_data": true
        },
        "dynamic_to_fixed_shape": {
            "type": "DynamicToFixedShape",
            "dim_param": [
                "component.vision_encoder.num_patches"
            ],
            "dim_value": [
                2520
            ],
            "save_as_external_data": true
        },
        "split_vision_pooler": {
            "type": "SplitVisionPooler",
            "stage_session_options": {
                "vision_encoder": {
                    "provider_options": [
                        { "OpenVINO": { "device_type": "NPU" } }
                    ]
                },
                "vision_pooler_projector": {
                    "log_id": "onnxruntime-genai",
                    "provider_options": []
                }
            },
            "save_as_external_data": true
        },
        "vision_cb": {
            "type": "EPContextBinaryGenerator",
            "components": [ "encoder" ],
            "provider_options": {
                "device_type": "NPU"
            },
            "session_options": {
                "optimization.disable_specified_optimizers": "QDQPropagationTransformer",
                "log_severity_level": 1
            },
            "update_genai_config": true,
            "genai_config_role": "vision"
        },
        "decoder_matmul_nbits_to_qdq": {
            "type": "MatMulNBitsToQDQ",
            "use_signed_int": true,
            "add_zero_point": false,
            "nodes_to_exclude": [
                "decoder/lm_head/MatMulNBits_node_1264"
            ],
            "save_as_external_data": true
        },
        "matmul_nbits_to_qdq": {
            "type": "MatMulNBitsToQDQ",
            "use_signed_int": true,
            "add_zero_point": true,
            "save_as_external_data": true
        },
        "sq_decoder": {
            "type": "OnnxStaticQuantization",
            "data_config": "calib",
            "activation_type": "uint16",
            "precision": "uint8",
            "quant_format": "QDQ",
            "calibration_providers": [
                "CPUExecutionProvider"
            ],
            "quant_preprocess": true,
            "op_types_to_exclude": [
                "GatherBlockQuantized",
                "GroupQueryAttention",
                "MatMulNBits",
                "ConstantOfShape"
            ],
            "nodes_to_exclude": [
                "decoder/lm_head/MatMulNBits_node_1264",
                "decoder/lm_head/MatMul_node_1264",
                "decoder/Div_node_1266",
                "decoder/Tanh_node_1267",
                "decoder/Mul_node_1268"
            ],
            "save_as_external_data": true
        },
        "sp": {
            "type": "SplitModel",
            "split_assignments": {
                "decoder.model.layers": 0,
                "decoder.lm_head": 1
            }
        },
        "kv": {
            "type": "DynamicToFixedShape",
            "dim_param": [
                "component.decoder.past_sequence_len",
                "component.decoder.kv_sequence_length"
            ],
            "dim_value": [
                1024,
                1024
            ]
        },
        "st": {
            "type": "StaticLLM",
            "batch_size": 1,
            "context_length": 64
        },
        "cb": {
            "type": "EPContextBinaryGenerator",
            "provider_options": {
                "device_type": "NPU",
                "load_config": "{\"NPU\":{\"NPU_COMPILER_TYPE\":\"DRIVER\"}}"
            },
            "session_options": {
                "optimization.disable_specified_optimizers": "QDQPropagationTransformer",
                "log_severity_level": 1
            },
            "weight_sharing": true,
            "compile_flow": "jit",
            "embed_context": false,
            "update_genai_config": true,
            "genai_config_role": "decoder"
        }
    },
    "builds": {
        "decoder": {
            "components": [ "decoder" ],
            "pipeline": [ "decoder_matmul_nbits_to_qdq", "gs_decoder", "sq_decoder", "sp",
                "kv",
                "st", "cb" ],
            "target": {
                "type": "LocalSystem",
                "accelerators": [
                    {
                        "device": "npu",
                        "execution_providers": [ "OpenVINOExecutionProvider" ]
                    }
                ]
            }
        },
        "vision": {
            "components": [ "vision_encoder" ],
            "pipeline": [ "matmul_nbits_to_qdq", "gs_vision", "dynamic_to_fixed_shape", "split_vision_pooler", "vision_cb" ],
            "target": {
                "type": "LocalSystem",
                "accelerators": [
                    {
                        "device": "npu",
                        "execution_providers": [ "OpenVINOExecutionProvider" ]
                    }
                ]
            }
        },
        "embedding": {
            "components": ["embedding"],
            "pipeline": [ "matmul_nbits_to_qdq"]
        }
    },
    "engine": {
        "cache_dir": ".olive-cache-ep181-driver-fresh"
    },
    "output_dir": "gemma4_ov_latest_ep_fresh",
    "log_severity_level": 1
}
