{
    "input_model": { "type": "ONNXModel", "model_path": "../multi_comp/gemma4_onnx/vision_encoder/model.onnx" },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "gpu",
                    "execution_providers": [
                        "CUDAExecutionProvider"
                    ]
                }
            ]
        },
        "target_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "npu",
                    "execution_providers": [
                        "QNNExecutionProvider"
                    ]
                }
            ]
        }
    },
    "data_configs": [
        {
            "name": "cauldron_vision_calibration",
            "user_script": "user_script.py",
            "load_dataset_config": {
                "type": "cauldron_calibration_dataset",
                "subsets": [
                    "vqav2",
                    "visual7w",
                    "ai2d",
                    "chartqa",
                    "docvqa",
                    "textvqa",
                    "screen2words",
                    "scienceqa"
                ],
                "samples_per_subset": 16,
                "seed": 42,
                "shuffle_buffer_size": 0,
                "max_soft_tokens": 280
            },
            "dataloader_config": {
                "type": "no_auto_batch_dataloader"
            }
        }
    ],
    "passes": {
        "matmul_nbits_to_qdq": {
            "type": "MatMulNBitsToQDQ",
            "use_signed_int": true,
            "add_zero_point": true,
            "save_as_external_data": true,
            "external_data_name": "model.onnx.data"
        },
        "graph_surgeries": {
            "type": "GraphSurgeries",
            "surgeries": [{"surgeon": "RemoveUnusedOutputs"},
                          {"surgeon": "SimplifiedLayerNormToL2Norm"},
                          {"surgeon": "RMSNormalizationToL2Norm"},
                          {"surgeon": "ReplaceAttentionMaskValue",  "threshold": -1e8}],
            "save_as_external_data": true,
            "external_data_name": "model.onnx.data"
        },
        "a16w8_static_quantization": {
            "type": "OnnxStaticQuantization",
            "data_config": "cauldron_vision_calibration",
            "activation_type": "uint16",
            "precision": "int8",
            "quant_format": "QDQ",
            "calibrate_method": "MinMax",
            "calibration_providers": [
                "CUDAExecutionProvider"
            ],
            "quant_preprocess": false,
            "prepare_qdq_config": true,
            "extra_options": {
                                "DedicatedQDQPair": true
                             },
            "save_as_external_data": true,
            "external_data_name": "model.onnx.data"
        },
        "dynamic_to_fixed_shape": {
            "type": "DynamicToFixedShape",
            "dim_param": [
                "component.vision_encoder.num_patches"
            ],
            "dim_value": [
                2520
            ],
            "save_as_external_data": true,
            "external_data_name": "model.onnx.data"
        },
        "split_vision_pooler": {
            "type": "SplitVisionPooler",
            "save_as_external_data": true
        }
    },
    "host": "local_system",
    "target": "target_system",
    "cache_dir": "cache",
    "output_dir": "models/vision_qdq",
    "no_artifacts": true,
    "log_severity_level": 0
}
