{
    "input_model": {
        "type": "CompositeModel",
        "model_path": "multi_comp/gemma4_onnx"
    },
    "systems": {
        "cpu_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "cpu",
                    "execution_providers": ["CPUExecutionProvider"]
                }
            ]
        },
        "qnn_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "npu",
                    "execution_providers": [
                        "QNNExecutionProvider"
                    ]
                }
            ]
        }
    },
    "data_configs": [
        {
            "name": "calib",
            "user_script": "npu/decoder_user_script.py",
            "load_dataset_config": {
                "type": "wikitext_decoder_calibration_dataset",
                "embedding_model_path": "multi_comp/gemma4_onnx/embedding/model.onnx",
                "num_samples": 32,
                "seq_len": 64,
                "past_len": 64
            },
            "dataloader_config": {
                "type": "no_auto_batch_dataloader"
            }
        },
        {
            "name": "vision_calib",
            "user_script": "npu/vision_user_script.py",
            "load_dataset_config": {
                "type": "cauldron_calibration_dataset",
                "subsets": [
                    "vqav2", "visual7w", "ai2d", "chartqa",
                    "docvqa", "textvqa", "screen2words", "scienceqa"
                ],
                "samples_per_subset": 16,
                "seed": 42,
                "shuffle_buffer_size": 0,
                "max_soft_tokens": 280
            },
            "dataloader_config": {
                "type": "no_auto_batch_dataloader"
            }
        }
    ],
    "passes": {
        "mq": {
            "type": "MatMulNBitsToQDQ",
            "use_int4": true,
            "add_zero_point": true,
            "use_int8_per_channel": true,
            "save_as_external_data": true,
            "nodes_to_exclude": [
                "decoder/lm_head/MatMulNBits_node_1174"
            ]
        },
        "gs": {
            "type": "GraphSurgeries",
            "surgeries": [
                {
                    "surgeon": "FuseDecomposedRMSNorm"
                },
                {
                    "surgeon": "RemoveRopeMultiCache"
                },
                {
                    "surgeon": "AttentionMaskToSequenceLengths"
                },
                {
                    "surgeon": "RemoveGidxFromMatMulNBits"
                },
                {
                    "surgeon": "RemoveUnusedNodeOutputs",
                    "op_types": [
                        "SkipSimplifiedLayerNormalization"
                    ]
                },
                {
                    "surgeon": "SimplifiedLayerNormToL2Norm",
                    "op_types": [
                        "SkipSimplifiedLayerNormalization"
                    ]
                }
            ],
            "save_as_external_data": true
        },
        "f16": {
            "type": "OnnxFloatToFloat16",
            "op_include_list": [
                "GroupQueryAttention"
            ],
            "keep_io_types": [
                "logits"
            ],
            "save_as_external_data": true
        },
        "dd": {
            "type": "GraphSurgeries",
            "surgeries": [
                {
                    "surgeon": "DeduplicateNodes"
                },
                {
                    "surgeon": "RemoveShapes"
                },
                {
                    "surgeon": "RemoveInitializerValueInfo"
                },
                {
                    "surgeon": "RemoveUnusedNodeOutputs",
                    "op_types": [
                        "SkipSimplifiedLayerNormalization"
                    ]
                },
                {
                    "surgeon": "ConstantAttributesToTensor"
                }
            ],
            "save_as_external_data": true
        },
        "sq": {
            "type": "OnnxStaticQuantization",
            "data_config": "calib",
            "activation_type": "uint16",
            "precision": "uint8",
            "calibration_providers": ["CPUExecutionProvider"],
            "quant_preprocess": true,
            "op_types_to_exclude": [
                "GatherBlockQuantized",
                "GroupQueryAttention",
                "MatMulNBits",
                "ConstantOfShape"
            ],
            "save_as_external_data": true,
            "nodes_to_exclude": [
                "decoder/Div_node_1176",
                "decoder/Tanh_node_1177",
                "decoder/Mul_node_1178"
            ]
        },
        "sp": {
            "type": "SplitModel",
            "split_assignments": "decoder.model.layers.0=0;decoder.model.layers.1=0;decoder.model.layers.2=0;decoder.model.layers.3=0;decoder.model.layers.4=0;decoder.model.layers.5=1;decoder.model.layers.6=1;decoder.model.layers.7=1;decoder.model.layers.8=1;decoder.model.layers.9=1;decoder.model.layers.10=2;decoder.model.layers.11=2;decoder.model.layers.12=2;decoder.model.layers.13=2;decoder.model.layers.14=2;decoder.model.layers.15=3;decoder.model.layers.16=3;decoder.model.layers.17=3;decoder.model.layers.18=3;decoder.model.layers.19=3;decoder.model.layers.20=4;decoder.model.layers.21=4;decoder.model.layers.22=4;decoder.model.layers.23=4;decoder.model.layers.24=4;decoder.model.layers.25=5;decoder.model.layers.26=5;decoder.model.layers.27=5;decoder.model.layers.28=5;decoder.model.layers.29=5;decoder.model.layers.30=6;decoder.model.layers.31=6;decoder.model.layers.32=6;decoder.model.layers.33=6;decoder.model.layers.34=6;decoder.lm_head=7"
        },
        "kv": {
            "type": "DynamicToFixedShape",
            "dim_param": [
                "component.decoder.past_sequence_len",
                "component.decoder.kv_sequence_length"
            ],
            "dim_value": [
                1024,
                1024
            ]
        },
        "st": {
            "type": "StaticLLM",
            "batch_size": 1,
            "context_length": 64
        },
        "cb": {
            "type": "EPContextBinaryGenerator",
            "provider_options": {
                "htp_performance_mode": "burst",
                "htp_graph_finalization_optimization_mode": "3",
                "soc_model": "60",
                "vtcm_mb": "7"
            },
            "weight_sharing": true,
            "session_options": {
                "optimization.disable_specified_optimizers": "QDQPropagationTransformer",
                "log_severity_level": 1
            }
        },
        "cp": {
            "type": "ComposeOnnxModels"
        },
        "vision_mq": {
            "type": "MatMulNBitsToQDQ",
            "use_signed_int": true,
            "add_zero_point": true,
            "save_as_external_data": true
        },
        "vision_gs": {
            "type": "GraphSurgeries",
            "surgeries": [
                {"surgeon": "RemoveUnusedNodeOutputs", "op_types": ["SkipSimplifiedLayerNormalization"]},
                {"surgeon": "SimplifiedLayerNormToL2Norm"},
                {"surgeon": "ReplaceAttentionMaskValue", "threshold": -1e8}
            ],
            "save_as_external_data": true
        },
        "vision_sq": {
            "type": "OnnxStaticQuantization",
            "data_config": "vision_calib",
            "activation_type": "uint16",
            "precision": "int8",
            "quant_format": "QDQ",
            "calibrate_method": "MinMax",
            "calibration_providers": ["CPUExecutionProvider"],
            "quant_preprocess": false,
            "prepare_qdq_config": true,
            "extra_options": {"DedicatedQDQPair": true},
            "save_as_external_data": true
        },
        "vision_fixed": {
            "type": "DynamicToFixedShape",
            "dim_param": ["component.vision_encoder.num_patches"],
            "dim_value": [2520],
            "save_as_external_data": true
        }
    },
    "max_concurrent_builds": 1,
    "builds": {
        "decoder": {
            "components": ["decoder"],
            "pipeline": ["mq", "gs", "f16", "dd", "sq", "sp", "kv", "st", "cb", "cp"]
        },
        "vision": {
            "components": ["vision_encoder"],
            "pipeline": ["vision_mq", "vision_gs", "vision_sq", "vision_fixed"]
        }
    },
    "host": "cpu_system",
    "target": "qnn_system",
    "log_severity_level": 0,
    "output_dir": "npu/output",
    "cache_dir": "npu/cache",
    "no_artifacts": true,
    "ort_log_severity_level": 1,
    "ort_py_log_severity_level": 1
}
